---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
const { title, heading, intro, description, canonical, image = '/img/karnak.jpg', crumbs, jsonLd, noindex = false } = Astro.props;
---
<Base title={title} description={description} canonical={canonical} ogImage={image} jsonLd={jsonLd} noindex={noindex}>
  <PageHero title={heading} intro={intro} crumbs={crumbs ?? [{ label: heading }]} image={image} />
  <slot />
</Base>
