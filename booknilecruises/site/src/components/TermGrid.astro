---
import { asset, srcsetAttr } from '@lib/content.mjs';
const { terms } = Astro.props;
---
<div class="terms">
  {terms.map((t) => {
    const img = t.trips.find((x) => x.image)?.image;
    const src = img?.card?.src ?? img?.src;
    return (
      <a class="term" href={t.href ?? t.url}>
        {src && <img src={asset(src)} srcset={srcsetAttr(img)} sizes="(max-width: 535px) calc(100vw - 40px), (max-width: 791px) calc((100vw - 56px) / 2), (max-width: 1047px) calc((100vw - 72px) / 3), (max-width: 1180px) calc((100vw - 88px) / 4), 273px" alt="" loading="lazy" decoding="async" />}
        <span class="label"><strong>{t.name}</strong><small>{t.trips.length} {t.trips.length === 1 ? 'trip' : 'trips'}</small></span>
      </a>
    );
  })}
</div>
<style>
  .terms { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .term { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--navy); color: #fff; text-decoration: none; display: flex; align-items: flex-end; }
  .term img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .term:hover img { transform: scale(1.05); }
  .term::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(22, 45, 75, .92)); }
  .label { position: relative; z-index: 1; padding: 18px; display: grid; gap: 2px; }
  .label strong { font: 400 26px var(--display); }
  .label small { color: var(--gold-lt); font-weight: 700; letter-spacing: .06em; }
</style>
