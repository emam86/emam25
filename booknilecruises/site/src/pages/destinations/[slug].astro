---
import Listing from '../../layouts/Listing.astro';
import { loadSite } from '@lib/content.mjs';

export function getStaticPaths() {
  return loadSite().terms.destination.map((term) => ({ params: { slug: term.url.split('/')[2] }, props: { term } }));
}
const { term } = Astro.props;
const n = term.trips.length;
---
<Listing
  title={term.seo.title || `${term.name} - Book Nile cruises`}
  heading={`${term.name} trips`}
  intro={`${n} ${n === 1 ? 'trip' : 'trips'} that visit ${term.name}: Nile cruises, day tours and tour packages.`}
  description={term.seo.description || `${n} ${n === 1 ? 'trip' : 'trips'} in ${term.name}, Egypt: Nile cruises, day tours and tour packages with per-person prices.`}
  canonical={term.url}
  trips={term.trips}
  crumbs={[{ label: 'Destinations', href: '/destinations/' }, { label: term.name }]}
/>
