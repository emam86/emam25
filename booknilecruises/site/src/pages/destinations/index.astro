---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import TermGrid from '../../components/TermGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { loadSite } from '@lib/content.mjs';
const site = loadSite();
const page = site.pages.find((p) => p.url === '/destinations/');
const terms = site.terms.destination.filter((t) => t.trips.length > 0);
---
<Base title={page?.seo.title || 'Destinations - Book Nile cruises'} description="Egypt destinations with Book Nile Cruises: Luxor, Aswan, Cairo, Alexandria, Hurghada, Sharm El Sheikh and Siwa." canonical="/destinations/">
  <PageHero title="Destinations" intro="Where our trips go. Pick a city to see its Nile cruises, day tours and packages." crumbs={[{ label: 'Destinations' }]} image="/img/karnak.jpg" />
  <section class="block"><div class="wrap"><TermGrid terms={terms} /></div></section>
  <CtaBand />
</Base>
