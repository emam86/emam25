---
import Page from '../layouts/Page.astro';
import Enquiry from '../components/Enquiry.astro';
import { SITE, whatsappUrl, mailtoUrl } from '@lib/site.mjs';
---
<Page title="Contact Us - Book Nile cruises" heading="Contact us"
  intro="Send us your travel dates and the trip you are interested in. We reply on WhatsApp or by email."
  description="Contact Book Nile Cruises in Luxor on WhatsApp +20 109 661 1124 or by email at info@booknilecruises.net to book a Nile cruise or Egypt tour."
  canonical="/contact-us/" image="/img/lake.jpg">
  <section class="block">
    <div class="wrap contact">
      <div class="ways">
        <a class="way" href={whatsappUrl('Hello, I would like to ask about a trip.')}>
          <span class="eyebrow">WhatsApp</span><strong>{SITE.phoneDisplay}</strong><small>Fastest reply</small>
        </a>
        <a class="way" href={mailtoUrl('Trip enquiry')}>
          <span class="eyebrow">Email</span><strong>{SITE.email}</strong><small>For detailed requests</small>
        </a>
        <div class="way">
          <span class="eyebrow">Phone</span><strong>{SITE.phoneDisplay}</strong><small>Also {SITE.phoneAlt}</small>
        </div>
        <div class="way">
          <span class="eyebrow">Office</span><strong>{SITE.address}</strong>
        </div>
      </div>
      <Enquiry id="contact-enq" />
    </div>
  </section>
</Page>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: start; }
  .ways { display: grid; gap: 12px; }
  .way { display: grid; gap: 4px; padding: 20px; background: #fff; border: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  a.way:hover { border-color: var(--gold-bright); }
  .way strong { font: 400 22px var(--display); color: var(--navy); overflow-wrap: anywhere; }
  .way small { color: var(--muted); }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>
