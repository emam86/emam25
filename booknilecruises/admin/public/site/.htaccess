# PHP public site. Admin and API use their own entry points and access rules.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^wp-login\.php$ / [R=301,L]

  # Only the root front controller can execute PHP outside admin/api.
  RewriteRule ^(?:admin|api)(?:/|$) - [L]
  RewriteRule ^(?!index\.php$).*\.(?:php[0-9]?|phtml|phar)(?:/.*)?$ - [F,NC,L]
  RewriteRule ^(?:old|wordpress-old[^/]*|wp-includes)(?:/.*)?$ - [R=404,L]
  RewriteRule ^wp-admin/.+$ - [R=404,L]
  RewriteRule ^wp-content/(?!uploads/).* - [R=404,L]
  RewriteRule ^wp-content/uploads/(.*)$ /images/$1 [R=301,L,NE]
  RewriteRule ^(?:sitemap_index|wp-sitemap[a-z0-9_-]*|[a-z0-9_-]+-sitemap[0-9]*)\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^sitemap\.rss$ /sitemap.xml [R=301,L]
  RewriteRule ^wp-admin/?$ / [R=301,L]

  # Old Astro directories must also pass through PHP during cutover.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(?:images/|assets/|img/logo\.(?:webp|png|svg)$|favicon\.(?:ico|png)$) - [L]
  RewriteRule ^index\.php$ - [L]
  RewriteRule ^ index.php [L]
</IfModule>
# mod_alias rules are inherited by every subfolder, even one whose own .htaccess turns on
# RewriteEngine (any old WordPress copy does, which cancels the rewrite rules above there).
# They back up those rules: WordPress leftovers stay 404 and no PHP file runs except the
# three entry points, wherever it sits.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(?:(?:old|wordpress-old[^/]*|wp-includes|wp-admin/.+)(?:/.*)?|wp-content/(?!uploads/).*)$
  RedirectMatch 403 (?i)^/(?!(?:admin/|api/)?index\.php$).*\.(?:php[0-9]?|phtml|phar)(?:/.*)?$
</IfModule>
<FilesMatch "\.(php[0-9]?|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>
<FilesMatch "^(readme\.html|license\.txt|wp-config.*|\.user\.ini|\.bnc-manifest|error_log|.*\.(sql|sql\.gz|tar\.gz|zip|bak|log))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
