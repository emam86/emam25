{"id": 7839, "base": "pages", "raw": "<!-- wp:html -->\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Poppins:wght@400;500;600&display=swap\"><style>.ma-gate{--night:#120807;--deep:#2b1411;--gold:#c9a15b;--gold-2:#e2c388;--sand:#f3e9d9;--sand-2:#cdb8b0;--cta:#f97150;--cta-2:#e25c3b}.ma-gate *{box-sizing:border-box}.ma-gate{margin:0;background:var(--night);color:var(--sand);font-family:Poppins,\"Segoe UI\",Arial,sans-serif;padding-inline:0;overflow-x:hidden}.ma-gate .gate{position:relative;height:min(92vh,860px);min-height:560px;overflow:hidden;perspective:1200px;background:var(--night);cursor:default}.ma-gate .scenes{position:absolute;inset:0;transform-style:preserve-3d}.ma-gate .scene{position:absolute;inset:-6%;opacity:0;transform:scale(1.25);filter:brightness(.4) blur(6px);transition:opacity 1.2s ease,transform 1.5s cubic-bezier(.2,.7,.2,1),filter 1.2s ease;will-change:transform,opacity,filter;pointer-events:none}.ma-gate .scene img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transform:translate(var(--px,0),var(--py,0)) scale(1.04);transition:transform .25s ease-out}.ma-gate .scene.is-active{opacity:1;transform:scale(1);filter:brightness(1) blur(0)}.ma-gate .scene.is-leaving{opacity:0;transform:scale(2.1);filter:brightness(.1) blur(10px);transition:opacity 1.3s ease .15s,transform 1.6s cubic-bezier(.6,0,.8,.2),filter 1.3s ease}.ma-gate .vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(90% 70% at 50% 45%,rgba(18,8,7,0) 35%,rgba(18,8,7,.55) 75%,rgba(18,8,7,.92) 100%),linear-gradient(to top,rgba(18,8,7,.95) 0%,rgba(18,8,7,.35) 30%,rgba(18,8,7,0) 60%)}.ma-gate .flash{position:absolute;inset:0;pointer-events:none;background:radial-gradient(40% 40% at 50% 50%,rgba(226,195,136,.9),rgba(18,8,7,1) 70%);opacity:0;transition:opacity .35s ease}.ma-gate .flash.on{opacity:1;transition:opacity .25s ease}.ma-gate .dust{position:absolute;inset:0;pointer-events:none;mix-blend-mode:screen;opacity:.9}.ma-gate .copy{position:absolute;left:clamp(20px,7vw,110px);right:clamp(20px,7vw,110px);bottom:clamp(72px,12vh,120px);z-index:5;max-width:720px;transform:translate(calc(var(--px,0) * -.5),calc(var(--py,0) * -.5))}.ma-gate .kicker{display:inline-flex;align-items:center;gap:12px;font:600 11px/1 Poppins,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}.ma-gate .kicker:before{content:\"\";width:34px;height:1px;background:var(--gold)}.ma-gate .kicker .n{color:var(--sand-2);letter-spacing:.14em}.ma-gate h1{font-family:\"Cormorant Garamond\",Georgia,serif;font-weight:500;font-size:clamp(46px,7vw,96px);line-height:.98;margin:16px 0 8px;color:#fff;letter-spacing:-.01em;text-wrap:balance}.ma-gate .sub{font-family:\"Cormorant Garamond\",Georgia,serif;font-style:italic;font-size:clamp(20px,2.4vw,30px);color:var(--gold-2);margin:0 0 14px}.ma-gate .text{font-size:16px;line-height:1.7;color:var(--sand-2);max-width:52ch;margin:0 0 26px}.ma-gate .ctas{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.ma-gate .btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;font:600 14px/1 Poppins,sans-serif;letter-spacing:.03em;text-decoration:none;cursor:pointer;border:0;transition:transform .2s,background .2s,border-color .2s}.ma-gate .btn-primary{background:var(--cta);color:#fff}.ma-gate .btn-primary:hover{background:var(--cta-2);transform:translateY(-1px)}.ma-gate .btn-ghost{background:transparent;color:var(--sand);border:1px solid rgba(243,233,217,.4)}.ma-gate .btn-ghost:hover{border-color:var(--gold);color:var(--gold-2)}.ma-gate .btn-ghost .arrow{display:inline-block;transition:transform .3s}.ma-gate .btn-ghost:hover .arrow{transform:translateX(5px)}.ma-gate .copy .anim{transition:opacity .6s ease,transform .6s ease}.ma-gate .copy.swap .anim{opacity:0;transform:translateY(14px)}.ma-gate .rail{position:absolute;left:0;right:0;bottom:0;z-index:6;display:flex;align-items:stretch;border-top:1px solid rgba(243,233,217,.12);background:linear-gradient(to top,rgba(18,8,7,.85),rgba(18,8,7,.35));backdrop-filter:blur(6px)}.ma-gate .rail button{flex:1;background:transparent;border:0;border-right:1px solid rgba(243,233,217,.1);color:var(--sand-2);padding:14px 10px 12px;text-align:left;cursor:pointer;font:500 12px/1.3 Poppins,sans-serif;letter-spacing:.1em;text-transform:uppercase;position:relative;transition:color .2s}.ma-gate .rail button:last-child{border-right:0}.ma-gate .rail button small{display:block;font:500 10px/1.2 Poppins,sans-serif;letter-spacing:.14em;color:rgba(243,233,217,.4);margin-bottom:4px}.ma-gate .rail button:hover,.ma-gate .rail button[aria-current=\"true\"]{color:#fff}.ma-gate .rail button .bar{position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--gold)}.ma-gate .rail button[aria-current=\"true\"] .bar{width:100%;transition:width var(--dur,7s) linear}.ma-gate .rail button:focus-visible{outline:2px solid var(--gold);outline-offset:-3px}.ma-gate .hint{position:absolute;top:18px;right:20px;z-index:6;font:500 11px/1 Poppins,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:rgba(243,233,217,.5)}@media (max-width:760px){.ma-gate .gate{height:min(88vh,760px);min-height:520px}.ma-gate .copy{bottom:88px}.ma-gate .text{font-size:14.5px;margin-bottom:18px}.ma-gate .rail button{padding:10px 8px;font-size:10px;letter-spacing:.06em}.ma-gate .rail button small{display:none}.ma-gate .hint{display:none}}@media (prefers-reduced-motion:reduce){.ma-gate .scene,.ma-gate .scene.is-leaving{transition:opacity .6s ease;transform:none!important;filter:none!important}.ma-gate .scene img{transition:none;transform:none}.ma-gate .copy{transform:none}}.ma-gate{width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);max-width:100vw} body{overflow-x:hidden} .traveltour-content-area{padding-top:0!important;padding-bottom:0!important} .gdlr-core-pbf-section:has(.ma-ring,.ma-gate){padding-top:0!important;padding-bottom:0!important}</style><div class=\"ma-gate\"><section class=\"gate\" id=\"gate\" aria-roledescription=\"carousel\" aria-label=\"Temples of Egypt\">\n  <div class=\"scenes\" id=\"scenes\"></div>\n  <div class=\"vignette\"></div>\n  <canvas class=\"dust\" id=\"dust\"></canvas>\n  <div class=\"flash\" id=\"flash\"></div>\n  <div class=\"hint\">Scroll, swipe or click to enter</div>\n  <div class=\"copy\" id=\"copy\">\n    <span class=\"kicker anim\"><span id=\"k-name\"></span><span class=\"n\" id=\"k-num\"></span></span>\n    <h1 class=\"anim\" id=\"h-title\"></h1>\n    <p class=\"sub anim\" id=\"h-sub\"></p>\n    <p class=\"text anim\" id=\"h-text\"></p>\n    <div class=\"ctas anim\">\n      <a class=\"btn btn-primary\" id=\"h-link\" href=\"#\">Book this tour</a>\n      <button type=\"button\" class=\"btn btn-ghost\" id=\"next\">Enter the temple <span class=\"arrow\">&rarr;</span></button>\n    </div>\n  </div>\n  <div class=\"rail\" id=\"rail\"></div>\n</section></div><script>const DATA = [{\"id\": \"abu-simbel-hall\", \"img\": \"https://egypttours-meritamun.com/wp-content/uploads/2024/07/interior-with-the-sculptures-of-the-pharaohs-in-th-2023-11-27-05-29-39-utc.jpg\", \"title\": \"Abu Simbel\", \"sub\": \"The Great Hall of Ramses II\", \"text\": \"Eight Osiris pillars lead to the inner sanctuary, where the sun reaches the gods twice a year.\", \"url\": \"https://egypttours-meritamun.com/tour/day-tour-abu-simbel-by-coach-from-aswan/\"}, {\"id\": \"abu-simbel\", \"img\": \"https://egypttours-meritamun.com/wp-content/uploads/2024/08/the-incredible-abu-simbel-temple-rebuilt-on-the-mo-2023-11-27-05-23-22-utc-Copy-1536x1012.jpg\", \"title\": \"The Colossi\", \"sub\": \"Abu Simbel's fa\u00e7ade, facing the Nile\", \"text\": \"Carved into the mountain in the 13th century BC, moved stone by stone in the 1960s to escape Lake Nasser.\", \"url\": \"https://egypttours-meritamun.com/tour/day-tour-abu-simbel-by-coach-from-aswan/\"}, {\"id\": \"karnak\", \"img\": \"https://egypttours-meritamun.com/wp-content/uploads/2024/08/karnak-temple-with-its-beautiful-corridor-of-ram-s-2023-11-27-04-53-51-utc-Copy-1536x1024.jpg\", \"title\": \"Karnak\", \"sub\": \"The avenue of ram-headed sphinxes\", \"text\": \"The largest religious complex ever built, added to by thirty pharaohs over two thousand years.\", \"url\": \"https://egypttours-meritamun.com/tour/day-tour-luxor-east-bank/\"}, {\"id\": \"hatshepsut\", \"img\": \"https://egypttours-meritamun.com/wp-content/uploads/2024/08/hatshepsut-s-funerary-temple-in-luxor-without-peop-2023-11-27-05-15-54-utc-Copy-1536x1072.jpg\", \"title\": \"Hatshepsut\", \"sub\": \"The terraces of Deir el-Bahari\", \"text\": \"The queen who ruled as pharaoh built her temple into the cliffs of the West Bank.\", \"url\": \"https://egypttours-meritamun.com/tour/day-tour-luxor-east-and-west-bank-2/\"}, {\"id\": \"philae\", \"img\": \"https://egypttours-meritamun.com/wp-content/uploads/2026/07/Philae_Temple_on_Nile_island_202608211606-1024x765.webp\", \"title\": \"Philae\", \"sub\": \"The island temple of Isis\", \"text\": \"Reached by boat from Aswan, the last temple where the old gods were worshipped.\", \"url\": \"https://egypttours-meritamun.com/tour/day-tour-aswan-philae-templeobeliskhigh-dam/\"}]; const gate=document.getElementById('gate'), scenes=document.getElementById('scenes'), rail=document.getElementById('rail'), flash=document.getElementById('flash'), copy=document.getElementById('copy'); const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches; const DUR = 7000; DATA.forEach((d,i)=>{ const f=document.createElement('figure'); f.className='scene'; f.innerHTML=`<img src=\"${d.img}\" alt=\"${d.title}, ${d.sub}\">`; scenes.appendChild(f); const b=document.createElement('button'); b.type='button'; b.innerHTML=`<small>0${i+1}</small>${d.title}<span class=\"bar\"></span>`; b.addEventListener('click',()=>go(i)); rail.appendChild(b); }); const figs=[...scenes.children], tabs=[...rail.children]; let cur=-1, busy=false, timer=null; function setCopy(i){ const d=DATA[i]; document.getElementById('k-name').textContent=d.title; document.getElementById('k-num').textContent=' \u00b7 0'+(i+1)+' / 0'+DATA.length; document.getElementById('h-title').textContent=d.title; document.getElementById('h-sub').textContent=d.sub; document.getElementById('h-text').textContent=d.text; document.getElementById('h-link').href=d.url; } function go(i, dir=1){ if(busy || i===cur) return; const n=(i+DATA.length)%DATA.length; busy=true; clearTimeout(timer); const prev=cur; cur=n; if(prev>=0){ figs[prev].classList.remove('is-active'); figs[prev].classList.add('is-leaving'); if(!reduced){ setTimeout(()=>flash.classList.add('on'),420); setTimeout(()=>flash.classList.remove('on'),780); } } copy.classList.add('swap'); setTimeout(()=>{ setCopy(n); copy.classList.remove('swap'); }, prev>=0?520:0); setTimeout(()=>{ figs[n].classList.add('is-active'); }, prev>=0?(reduced?200:450):0); tabs.forEach((t,k)=>{ t.setAttribute('aria-current', k===n); const bar=t.querySelector('.bar'); bar.style.transition='none'; bar.style.width='0'; void bar.offsetWidth; bar.style.transition=''; }); setTimeout(()=>{ if(prev>=0) figs[prev].classList.remove('is-leaving'); busy=false; arm(); }, prev>=0?1500:300); } function arm(){ clearTimeout(timer); timer=setTimeout(()=>{ if(!hover) go(cur+1); else arm(); }, DUR); } let hover=false; gate.addEventListener('pointerenter',()=>hover=true); gate.addEventListener('pointerleave',()=>{hover=false; gate.style.setProperty('--px','0px'); gate.style.setProperty('--py','0px'); figs.forEach(f=>{f.style.transform=''}); }); document.getElementById('next').addEventListener('click',()=>go(cur+1)); let wheelLock=0; gate.addEventListener('wheel',e=>{ if(Math.abs(e.deltaY)<20) return; const dir=e.deltaY>0?1:-1; if((dir>0&&cur>=DATA.length-1)||(0>dir&&1>cur)) return; const now=Date.now(); e.preventDefault(); if(now-wheelLock<1400) return; wheelLock=now; go(cur+dir); },{passive:false}); let tx=0,ty=0; gate.addEventListener('touchstart',e=>{tx=e.touches[0].clientX; ty=e.touches[0].clientY},{passive:true}); gate.addEventListener('touchend',e=>{ const dx=e.changedTouches[0].clientX-tx, dy=e.changedTouches[0].clientY-ty; if(Math.abs(dx)>50 && Math.abs(dx)>Math.abs(dy)) go(cur+(dx<0?1:-1)); },{passive:true}); addEventListener('keydown',e=>{ const r=gate.getBoundingClientRect(); if(r.bottom<0||r.top>innerHeight) return; if(e.key==='ArrowRight'||e.key==='ArrowDown') go(cur+1); if(e.key==='ArrowLeft'||e.key==='ArrowUp') go(cur-1); }); gate.addEventListener('pointermove',e=>{ if(reduced) return; const r=gate.getBoundingClientRect(); const x=(e.clientX-r.left)/r.width-.5, y=(e.clientY-r.top)/r.height-.5; gate.style.setProperty('--px',(x*-28)+'px'); gate.style.setProperty('--py',(y*-18)+'px'); const f=figs[cur]; if(f&&!busy) f.style.transform=`scale(1) rotateY(${x*4}deg) rotateX(${y*-3}deg)`; }); const cv=document.getElementById('dust'), cx=cv.getContext('2d'); let P=[]; function resize(){ cv.width=gate.clientWidth; cv.height=gate.clientHeight; P=Array.from({length:reduced?0:70},()=>({x:Math.random()*cv.width,y:Math.random()*cv.height,r:Math.random()*1.8+.4,s:Math.random()*.25+.08,a:Math.random()*Math.PI*2,o:Math.random()*.5+.2})); } function dust(){ cx.clearRect(0,0,cv.width,cv.height); for(const p of P){ p.y-=p.s; p.x+=Math.sin(p.a+=0.01)*.15; if(p.y<-5){p.y=cv.height+5;p.x=Math.random()*cv.width} cx.beginPath(); cx.arc(p.x,p.y,p.r,0,Math.PI*2); cx.fillStyle=`rgba(226,195,136,${p.o})`; cx.fill(); } requestAnimationFrame(dust); } addEventListener('resize',resize); resize(); if(!reduced) dust(); go(0);</script>\n<!-- /wp:html -->"}